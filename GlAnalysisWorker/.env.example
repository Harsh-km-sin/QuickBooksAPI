# Azure Service Bus
SERVICE_BUS_CONNECTION_STRING=
GL_ANALYSIS_QUEUE_NAME=gl-analysis

# Azure Blob Storage (leave empty to use local temp folder)
BLOB_STORAGE_CONNECTION_STRING=

# Azure SQL Database
SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=<server>.database.windows.net;Database=<db>;Uid=<user>;Pwd=<pass>;Encrypt=yes;

# Worker behaviour
LOG_LEVEL=INFO
MAX_WAIT_SECONDS=10
